@startuml C4_Context_WarmHome
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml

LAYOUT_WITH_LEGEND()

title Контекстная диаграмма C4 — «Тёплый дом» (As-Is)

Person(resident, "Житель поселка", "Управляет отоплением через веб-интерфейс")
Person(admin, "Администратор", "Конфигурирует систему и управляет пользователями")

System(smartHome, "Теплый дом", "Монолитное Go-приложение. Управляет датчиками температуры и отоплением умного дома. Порт: 8080")

System_Ext(tempSensors, "IoT-датчики температуры", "Физические датчики в комнатах (Living Room, Bedroom, Kitchen)")
System_Ext(heatingDevices, "Устройства отопления", "Физические термостаты и нагреватели в домах")
System_Ext(webBrowser, "Веб-браузер", "Клиентское приложение для управления системой")

Rel(resident, webBrowser, "Просматривает температуру, управляет отоплением", "HTTPS")
Rel(admin, webBrowser, "Управляет конфигурацией", "HTTPS")
Rel(webBrowser, smartHome, "REST API-запросы", "HTTP/JSON")
Rel(tempSensors, smartHome, "Отправляет показания (PATCH /sensors/:id/value)", "HTTP/JSON")
Rel(smartHome, heatingDevices, "Управляющие команды (вкл/выкл, целевая температура)", "HTTP")
Rel(smartHome, resident, "Push-уведомления о состоянии системы", "WebSocket/HTTP")

@enduml
